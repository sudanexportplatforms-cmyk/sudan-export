# Sudan Export — Environment Variables
# Copy this file to .env and fill in your values.
# On Replit, use the Secrets panel instead of a .env file.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/sudanexport

# Express session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string

# ── Clerk Auth ───────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys

# Server-side Clerk secret key (keep private)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Publishable key (used by both server middleware and frontend build)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Clerk proxy path — do not change; used by clerkProxyMiddleware
VITE_CLERK_PROXY_URL=/api/clerk

# ── Email (optional) ─────────────────────────────────────────────────────────
# Get from https://resend.com → API Keys
# Without this, emails are logged as "skipped" but the app works normally.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender display name + address (must match a verified Resend domain)
EMAIL_FROM=Sudan Export <noreply@yourdomain.com>

# Base URL used in email links — set to your production domain
APP_BASE_URL=https://your-app.replit.app

# ── Runtime (injected automatically by Replit workflows) ─────────────────────
# Do NOT set these manually — they are managed by the platform.
# PORT=8080
